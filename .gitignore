# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Node
node_modules/
.env
.env.local
package.json
package-lock.json

# Logs
*.log

# Database files (scraper artifacts)
*.db

# Scraper/dev scripts (not needed for deploy)
scraper.js
export*.js
check*.js
diagnose*.js
extract*.js
create-*.js
run-scraper.js
rescrape*.js
*.html
!static/**/*.html
.vercel

# Unused Next.js version (not deployed)
web/

# OG image conversion script
convert-og-image.js

# Large data source files (use create-column-index.js to rebuild columns.json)
build-data/
static/data/columns-full.json
static/data/columns-1.json
static/data/columns-2.json

# Dev/debug artifacts
*.sql
update-stats.js
static/data/column-index.json

# Credentials / tokens (NEVER commit)
gsc-token.json
client_secret*.json

# Utility scripts (not deployed)
setup-gsc.py
submit-indexnow.py

# Idea notes
skillidea/

# The documented build pipeline -- the export*/create-* globs above are catch-alls
# for scratch scripts and were silently swallowing these. They carry no secrets,
# and without them a fresh clone cannot rebuild the data at all.
!export.js
!export-simple.js
!create-column-index.js
